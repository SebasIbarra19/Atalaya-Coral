# Copy to .env and fill in. Never commit .env.
# Placeholders only, no real values here.

# Database (local development)
POSTGRES_USER=atalaya
# Generate with: openssl rand -hex 24 (hex keeps DATABASE_URL valid)
POSTGRES_PASSWORD=change-me
POSTGRES_DB=atalaya
# Administrator: used by dbmate for migrations (ADR-017). sslmode=disable only for the local database.
DATABASE_URL=postgresql://atalaya:change-me@localhost:5432/atalaya?sslmode=disable

# Application roles (F1-T00d). Each gets its own hex password.
ATALAYA_INGEST_PASSWORD=change-me
ATALAYA_API_PASSWORD=change-me
INGEST_DATABASE_URL=postgresql://atalaya_ingest:change-me@localhost:5432/atalaya?sslmode=disable
API_DATABASE_URL=postgresql://atalaya_api:change-me@localhost:5432/atalaya?sslmode=disable

# API
API_ADMIN_KEY=change-me

# NOAA ERDDAP base URL: [TO DEFINE in F1-T02 after exploring the dataset]
ERDDAP_BASE_URL=
